# {{ ansible_managed }}
# RustFS server environment file - sourced by the systemd unit.
# This file MUST be identical across every node in the deployment.

# Volumes / topology using {x...y} expansion notation.
RUSTFS_VOLUMES="{{ rustfs_volumes | join(' ') }}"

# S3 API listen address.
RUSTFS_ADDRESS="{{ rustfs_address }}"

# Root credentials (keep identical on every node).
RUSTFS_ACCESS_KEY={{ rustfs_access_key }}
RUSTFS_SECRET_KEY={{ rustfs_secret_key }}

{% if rustfs_console_enable %}
# Built-in web console.
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CONSOLE_ADDRESS="{{ rustfs_console_address }}"
{% endif %}

# ---------------------------------------------------------------------------
# Logging (rustfs-obs)
# ---------------------------------------------------------------------------
RUSTFS_OBS_LOGGER_LEVEL={{ rustfs_log_level }}
RUST_LOG={{ rustfs_log_level }}
RUSTFS_OBS_LOG_DIRECTORY="{{ rustfs_log_dir }}/"
RUSTFS_OBS_LOG_ROTATION_TIME={{ rustfs_log_rotation_time }}
RUSTFS_OBS_LOG_KEEP_FILES={{ rustfs_log_keep_files }}

# ---------------------------------------------------------------------------
# Log cleanup / rolling files
# https://github.com/rustfs/rustfs/blob/main/crates/obs/README.md
# ---------------------------------------------------------------------------
RUSTFS_OBS_LOG_MAX_TOTAL_SIZE_BYTES={{ rustfs_log_max_total_size_bytes }}
RUSTFS_OBS_LOG_MAX_SINGLE_FILE_SIZE_BYTES={{ rustfs_log_max_single_file_size_bytes }}
RUSTFS_OBS_LOG_COMPRESS_OLD_FILES={{ rustfs_log_compress_old_files | lower }}
RUSTFS_OBS_LOG_COMPRESSION_ALGORITHM={{ rustfs_log_compression_algorithm }}
RUSTFS_OBS_LOG_COMPRESSED_FILE_RETENTION_DAYS={{ rustfs_log_compressed_file_retention_days }}
RUSTFS_OBS_LOG_CLEANUP_INTERVAL_SECONDS={{ rustfs_log_cleanup_interval_seconds }}
RUSTFS_OBS_LOG_PARALLEL_COMPRESS={{ rustfs_log_parallel_compress | lower }}
RUSTFS_OBS_LOG_PARALLEL_WORKERS={{ rustfs_log_parallel_workers }}
RUSTFS_OBS_LOG_ZSTD_COMPRESSION_LEVEL={{ rustfs_log_zstd_compression_level }}
RUSTFS_OBS_LOG_DRY_RUN={{ rustfs_log_dry_run | lower }}

# ---------------------------------------------------------------------------
# io_uring (opt-in read backend; Linux 5.10+)
# https://github.com/rustfs/rustfs/blob/main/docs/operations/io-uring-initialization.md
# ---------------------------------------------------------------------------
RUSTFS_IO_URING_READ_ENABLE={{ rustfs_enable_io_uring | lower }}
{% if rustfs_io_uring_shards is not none %}
RUSTFS_IO_URING_SHARDS={{ rustfs_io_uring_shards }}
{% endif %}
{% if rustfs_io_uring_max_driver_threads is not none %}
RUSTFS_IO_URING_MAX_DRIVER_THREADS={{ rustfs_io_uring_max_driver_threads }}
{% endif %}
{% if rustfs_io_uring_read_budget_total_bytes is not none %}
RUSTFS_IO_URING_READ_BUDGET_TOTAL_BYTES={{ rustfs_io_uring_read_budget_total_bytes }}
{% endif %}
{% if rustfs_io_uring_read_budget_driver_bytes is not none %}
RUSTFS_IO_URING_READ_BUDGET_DRIVER_BYTES={{ rustfs_io_uring_read_budget_driver_bytes }}
{% endif %}
{% if rustfs_io_uring_read_result_budget_bytes is not none %}
RUSTFS_IO_URING_READ_RESULT_BUDGET_BYTES={{ rustfs_io_uring_read_result_budget_bytes }}
{% endif %}
{% if rustfs_env_extra | length > 0 %}

# Extra options.
{% for env in rustfs_env_extra %}
{{ env }}
{% endfor %}
{% endif %}
