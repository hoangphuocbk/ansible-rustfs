# {{ ansible_managed }}

[Unit]
Description=RustFS Object Storage Server
Documentation=https://rustfs.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User={{ rustfs_user }}
Group={{ rustfs_group }}

# Working directory used by the upstream unit.
WorkingDirectory={{ rustfs_working_directory }}

# Environment-driven startup. RustFS reads volumes, listeners, credentials and
# other runtime settings from RUSTFS_* variables in this file.
EnvironmentFile={{ rustfs_envfile }}
ExecStart={{ rustfs_bin_path }} server

# Service logging: stdout/stderr go to the journal. rustfs-obs continues to
# write rotated logs to rustfs_log_dir.
{% if rustfs_log_dir | dirname == '/var/log' %}
LogsDirectory={{ rustfs_log_dir | basename }}
LogsDirectoryMode=0750
{% endif %}
StandardOutput=journal
StandardError=journal

# Resource limits
LimitNOFILE={{ rustfs_limit_nofile }}
LimitNPROC={{ rustfs_limit_nproc }}
TasksMax=infinity

# Restart policy
Restart=always
RestartSec={{ rustfs_restart_sec }}

# Type=notify waits for READY=1, so the startup timeout must cover RustFS
# initialization plus runtime readiness checks on slower disks or cold starts.
# Since 1.0.5 startup readiness also waits (up to
# RUSTFS_STARTUP_READINESS_MAX_WAIT_SECS, default 120s) for peers to re-admit
# this node, so keep this safely above that budget.
TimeoutStartSec=300s
TimeoutStopSec=45s

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
ReadWritePaths={{ ([rustfs_log_dir] + rustfs_datadirs) | unique | join(' ') }}

[Install]
WantedBy=multi-user.target
